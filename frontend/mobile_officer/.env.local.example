# Kenya Overwatch Mobile Officer App Environment Variables

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Feature Flags
NEXT_PUBLIC_ENABLE_ANPR=true
NEXT_PUBLIC_ENABLE_WEAPON_DETECTION=true
NEXT_PUBLIC_ENABLE_RISK_SCORING=true

# Map Configuration
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# App Configuration
NEXT_PUBLIC_APP_NAME=Kenya Overwatch Officer
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_REGION=Nairobi Metropolitan

# Debug
NEXT_PUBLIC_DEBUG=false
