# Kenya Overwatch Citizen Portal Environment Variables

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Map Configuration
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# App Configuration
NEXT_PUBLIC_APP_NAME=Kenya Overwatch Citizen Portal
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_REGION=Nairobi Metropolitan

# Emergency Contact
NEXT_PUBLIC_EMERGENCY_NUMBER=999
NEXT_PUBLIC_POLICE_NUMBER=112

# Debug
NEXT_PUBLIC_DEBUG=false
