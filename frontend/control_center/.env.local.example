# Kenya Overwatch Frontend Environment Variables
# NTSA Road Safety Monitoring System

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8001
NEXT_PUBLIC_WS_URL=ws://localhost:8001

# Feature Flags
NEXT_PUBLIC_ENABLE_ANPR=true
NEXT_PUBLIC_ENABLE_WEAPON_DETECTION=true
NEXT_PUBLIC_ENABLE_RISK_SCORING=true

# Map Configuration (OpenStreetMap - free, no API key needed)
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# UI Configuration
NEXT_PUBLIC_APP_NAME=NTSA Road Safety
NEXT_PUBLIC_APP_VERSION=2.0.0
NEXT_PUBLIC_REGION=Nairobi Metropolitan
NEXT_PUBLIC_TIMEZONE=Africa/Nairobi

# Analytics (optional)
NEXT_PUBLIC_GA_TRACKING_ID=

# Refresh Intervals (in milliseconds)
NEXT_PUBLIC_REFRESH_INTERVAL_CAMERAS=30000
NEXT_PUBLIC_REFRESH_INTERVAL_INCIDENTS=15000
NEXT_PUBLIC_REFRESH_INTERVAL_METRICS=5000

# Debug
NEXT_PUBLIC_DEBUG=false
