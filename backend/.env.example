# Kenya Overwatch Environment Configuration
# Copy this file to .env and fill in the actual values
# Generated: 2026-03-07

# ==================== APP CONFIG (Required) ====================
OVERWATCH_ENV=development|staging|production
DEBUG=false
APP_NAME=Kenya Overwatch Production System
APP_VERSION=2.0.0

# ==================== DATABASE (Required) ====================
# PostgreSQL recommended for production
# DATABASE_URL=postgresql://username:password@host:5432/database_name?sslmode=require
# SQLite for development:
DATABASE_URL=sqlite:///./ntsa_overwatch.db

# ==================== REDIS (Required for production) ====================
# Redis URL for caching and rate limiting
REDIS_URL=redis://localhost:6379/0

# ==================== MINIO / S3 OBJECT STORAGE (Required) ====================
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ==================== JWT & ENCRYPTION (Required) ====================
# Generate strong secrets:
# - JWT_SECRET: openssl rand -base64 64
# - ENCRYPTION_KEY: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-at-least-256-bits-change-in-production
ENCRYPTION_KEY=your-32-char-encryption-key-change-this-too!

# ==================== AI MODELS ====================
# Paths inside container (models are mounted at /app/models)
YOLO_WEIGHTS_PATH=/app/models/yolo/yolov8n.pt
ANPR_MODEL_PATH=/app/models/anpr/license_plate_recognition.pt
BEHAVIOR_MODEL_PATH=/app/models/behavior/behavior_model.pt

# ==================== EXTERNAL SERVICES ====================
# SMS Provider (africastalking recommended for Kenya)
SMS_PROVIDER=africastalking
SMS_USERNAME=your_at_username
SMS_API_KEY=your_at_api_key

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@kenyaoverwatch.go.ke

# Map Provider
MAP_PROVIDER=openstreetmap
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-if-using-google

# Webhook for critical alerts
HIGH_RISK_WEBHOOK=https://your-domain.com/webhooks/high-risk

# ==================== PERFORMANCE TUNING ====================
# Leave defaults unless you know what you're doing
MAX_CONCURRENT_STREAMS=10
MAX_PROCESSING_FPS=30
MAX_QUEUE_SIZE=1000
WORKER_THREADS=4

# ==================== MONITORING ====================
PROMETHEUS_PORT=9090
HEALTH_CHECK_INTERVAL=30
LOG_LEVEL=INFO
STRUCTURED_LOGGING=true
METRICS_ENABLED=true
JAEGER_ENDPOINT=http://localhost:14268/api/traces

# ==================== API CONFIGURATION ====================
API_HOST=0.0.0.0
API_PORT=8001
API_WORKERS=4
CORS_ORIGINS=*
RATE_LIMIT_PER_MINUTE=60

# ==================== FRONTEND URLS ====================
CONTROL_CENTER_URL=http://localhost:3000
CITIZEN_APP_URL=http://localhost:3002
OFFICER_APP_URL=http://localhost:3001

# ==================== DEVELOPMENT FLAGS ====================
# Skip authentication (ONLY for development/testing)
OW_DEV_NO_AUTH=0
# Initialize database on startup
INIT_DB=0
# Enable test mode (auto-bypasses RBAC)
OW_TESTS=0

# ==================== DEPLOYMENT ====================
# Docker image tags
BACKEND_IMAGE=kenya-overwatch-backend:latest
FRONTEND_IMAGE=kenya-overwatch-frontend:latest
