# Kenya Overwatch - Environment Configuration
# Copy this file to .env and fill in the values

# ==================== REQUIRED IN PRODUCTION ====================

# Generate a secure JWT secret: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-secure-jwt-secret-key-here

# Generate a secure API key: python -c "import secrets; print(secrets.token_hex(32))"
API_SECRET_KEY=your-secure-api-secret-key-here

# Comma-separated API keys for external services
API_KEYS=your-api-key-1,your-api-key-2

# Initial password for default users - CHANGE IMMEDIATELY AFTER FIRST LOGIN
# Must be at least 8 characters with uppercase, lowercase, and digits
INITIAL_SETUP_PASSWORD=SecurePass123!

# ==================== DATABASE ====================
POSTGRES_PASSWORD=your-secure-postgres-password
DATABASE_URL=postgresql://overwatch:${POSTGRES_PASSWORD}@postgres:5432/overwatch_db

# ==================== REDIS ====================
REDIS_URL=redis://redis:6379/0

# ==================== ENVIRONMENT ====================
OVERWATCH_ENV=production
OVERWATCH_DEBUG=false
LOG_LEVEL=info

# ==================== EXTERNAL SERVICES (Optional) ====================

# Email notifications
EMAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-email-password
EMAIL_FROM=noreply@ntsa.go.ke

# SMS notifications  
SMS_ENABLED=false
SMS_API_KEY=your-sms-api-key
SMS_API_SECRET=your-sms-api-secret

# ==================== FRONTEND ====================
NEXT_PUBLIC_API_URL=http://localhost:8001
NEXT_PUBLIC_WS_URL=ws://localhost:8001
